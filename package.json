{
  "name": "grillado",
  "version": "0.1.0",
  "description": "Turn a raw idea into a plan you understand, one round of questions at a time. Runs on your local coding agent CLI.",
  "license": "MIT",
  "author": "Victor Mesquita",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-teles/grillado.git"
  },
  "type": "module",
  "bin": {
    "grillado": "dist/cli.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "build": "npm run build:web && npm run build:cli && npm run check:banned",
    "check:banned": "bun scripts/check-banned.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test test/",
    "e2e": "node e2e/run.mjs && node e2e/comments.mjs && node e2e/slash.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.61.0",
    "mermaid": "12.2.0",
    "playwright-core": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "zod": "^4.6.7"
  }
}
